#!/bin/bash

ENV=${1:-dev}
CONTAINER="etf_${ENV}_web-container"
CONFIG_PATH="src/lib/utils/better-auth/server.ts"

docker exec -it "$CONTAINER" npx @better-auth/cli@latest generate --yes --config "$CONFIG_PATH"
docker exec -it "$CONTAINER" npx @better-auth/cli@latest migrate --yes --config "$CONFIG_PATH"